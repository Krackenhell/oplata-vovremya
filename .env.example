# Скопируйте в .env и заполните. Файл .env не попадает в git.
# Decision-модель Jev (TypeSafe System One API)
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# GigaChat (developers.sber.ru) — ключ авторизации Basic
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2
# On-prem альтернатива: любой OpenAI-совместимый сервер (vLLM с T-Pro / Qwen3 / GigaChat on-prem)
OPENAI_BASE_URL=
OPENAI_MODEL=
